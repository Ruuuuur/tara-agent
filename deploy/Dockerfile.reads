# 复用已经验证的后端依赖，只增加离线生信程序；不改写在线镜像。
ARG TARA_BACKEND_IMAGE
FROM ${TARA_BACKEND_IMAGE}
ARG DEBIAN_MIRROR=https://deb.debian.org/debian
USER root
RUN sed -i "s|http://deb.debian.org/debian-security|${DEBIAN_MIRROR}-security|g; s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 install -y --no-install-recommends bowtie2 fastp \
    && rm -rf /var/lib/apt/lists/*
COPY backend/src /opt/tara-reads/src
ENV PYTHONPATH="/opt/tara-reads/src" OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
USER 10001:10001
ENTRYPOINT ["python", "-m", "tara_agent.data.read_pipeline"]
